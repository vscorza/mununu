context ResponseWithinDeadlineExample {
    alphabet {
        label request_sig;
        label response_sig;
        label timeout_sig;
        label record_breach;
    }

    automata {
        automaton Process {
            states {
                state Idle initial;
                state Handling_Request;
                state Breach_Recorded;
                state Closed;
            }

            transitions {
                transition Idle -> Handling_Request on label request_sig;
                transition Handling_Request -> Closed on label response_sig;
                transition Handling_Request -> Breach_Recorded on label timeout_sig;
                transition Breach_Recorded -> Closed on label record_breach;
            }
        }
    }
}
