// Scalable GR(1) benchmark — 2 conjunct(s), 12 states
//   Property: ∧_{i=0}^{1} (□◇ Req_i → □◇ Grant_i)
//   States:   Hub + 2×(Req_i, Grant_i) + 7 Noise states
//   Generated by examples/scalable/gen_gr1.py
//   Run: mununu context eval FILE --formula gr1_liveness --automaton Scheduler

context gr1_n02_s0000012 {
    alphabet {
        label req_0;
        label grant_0;
        label done_0;
        label req_1;
        label grant_1;
        label done_1;
        label tick;
    }

    automata {
        automaton Scheduler {
            controllable {
                label grant_0;
                label grant_1;
            }
            states {
                state Hub initial;
                state Req0;
                state Grant0;
                state Req1;
                state Grant1;
                state Noise0;
                state Noise1;
                state Noise2;
                state Noise3;
                state Noise4;
                state Noise5;
                state Noise6;
            }
            transitions {
                transition Hub -> Req0 on label req_0;
                transition Req0 -> Grant0 on label grant_0;
                transition Grant0 -> Hub on label done_0;
                transition Hub -> Req1 on label req_1;
                transition Req1 -> Grant1 on label grant_1;
                transition Grant1 -> Hub on label done_1;
                transition Hub -> Noise0 on label tick;
                transition Noise0 -> Hub on label tick;
                transition Hub -> Noise1 on label tick;
                transition Noise1 -> Hub on label tick;
                transition Hub -> Noise2 on label tick;
                transition Noise2 -> Hub on label tick;
                transition Hub -> Noise3 on label tick;
                transition Noise3 -> Hub on label tick;
                transition Hub -> Noise4 on label tick;
                transition Noise4 -> Hub on label tick;
                transition Hub -> Noise5 on label tick;
                transition Noise5 -> Hub on label tick;
                transition Hub -> Noise6 on label tick;
                transition Noise6 -> Hub on label tick;
            }
        }
    }

    mu_formulas {
        formula gr1_liveness {
            over Scheduler;
            body = ((! (nu NuA0. (mu MuA0. (Req0 || <> MuA0)) && ([] NuA0)))
                    || (nu NuG0. (mu MuG0. (Grant0 || <> MuG0)) && ([] NuG0)))
                    && ((! (nu NuA1. (mu MuA1. (Req1 || <> MuA1)) && ([] NuA1)))
                    || (nu NuG1. (mu MuG1. (Grant1 || <> MuG1)) && ([] NuG1)));
        }
    }

    controllers {
        controller fair_scheduler {
            source Scheduler;
            satisfying gr1_liveness;
        }
    }
}
