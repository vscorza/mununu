// Scalable GR(1) benchmark — 10 conjunct(s), 21 states
//   Property: ∧_{i=0}^{9} (□◇ Req_i → □◇ Grant_i)
//   States:   Hub + 10×(Req_i, Grant_i) + 0 Noise states
//   Generated by examples/scalable/gen_gr1.py
//   Run: mununu context eval FILE --formula gr1_liveness --automaton Scheduler

context gr1_n10_s0000021 {
    alphabet {
        label req_0;
        label grant_0;
        label done_0;
        label req_1;
        label grant_1;
        label done_1;
        label req_2;
        label grant_2;
        label done_2;
        label req_3;
        label grant_3;
        label done_3;
        label req_4;
        label grant_4;
        label done_4;
        label req_5;
        label grant_5;
        label done_5;
        label req_6;
        label grant_6;
        label done_6;
        label req_7;
        label grant_7;
        label done_7;
        label req_8;
        label grant_8;
        label done_8;
        label req_9;
        label grant_9;
        label done_9;
    }

    automata {
        automaton Scheduler {
            controllable {
                label grant_0;
                label grant_1;
                label grant_2;
                label grant_3;
                label grant_4;
                label grant_5;
                label grant_6;
                label grant_7;
                label grant_8;
                label grant_9;
            }
            states {
                state Hub initial;
                state Req0;
                state Grant0;
                state Req1;
                state Grant1;
                state Req2;
                state Grant2;
                state Req3;
                state Grant3;
                state Req4;
                state Grant4;
                state Req5;
                state Grant5;
                state Req6;
                state Grant6;
                state Req7;
                state Grant7;
                state Req8;
                state Grant8;
                state Req9;
                state Grant9;
            }
            transitions {
                transition Hub -> Req0 on label req_0;
                transition Req0 -> Grant0 on label grant_0;
                transition Grant0 -> Hub on label done_0;
                transition Hub -> Req1 on label req_1;
                transition Req1 -> Grant1 on label grant_1;
                transition Grant1 -> Hub on label done_1;
                transition Hub -> Req2 on label req_2;
                transition Req2 -> Grant2 on label grant_2;
                transition Grant2 -> Hub on label done_2;
                transition Hub -> Req3 on label req_3;
                transition Req3 -> Grant3 on label grant_3;
                transition Grant3 -> Hub on label done_3;
                transition Hub -> Req4 on label req_4;
                transition Req4 -> Grant4 on label grant_4;
                transition Grant4 -> Hub on label done_4;
                transition Hub -> Req5 on label req_5;
                transition Req5 -> Grant5 on label grant_5;
                transition Grant5 -> Hub on label done_5;
                transition Hub -> Req6 on label req_6;
                transition Req6 -> Grant6 on label grant_6;
                transition Grant6 -> Hub on label done_6;
                transition Hub -> Req7 on label req_7;
                transition Req7 -> Grant7 on label grant_7;
                transition Grant7 -> Hub on label done_7;
                transition Hub -> Req8 on label req_8;
                transition Req8 -> Grant8 on label grant_8;
                transition Grant8 -> Hub on label done_8;
                transition Hub -> Req9 on label req_9;
                transition Req9 -> Grant9 on label grant_9;
                transition Grant9 -> Hub on label done_9;
            }
        }
    }

    mu_formulas {
        formula gr1_liveness {
            over Scheduler;
            body = ((! (nu NuA0. (mu MuA0. (Req0 || <> MuA0)) && ([] NuA0)))
                    || (nu NuG0. (mu MuG0. (Grant0 || <> MuG0)) && ([] NuG0)))
                    && ((! (nu NuA1. (mu MuA1. (Req1 || <> MuA1)) && ([] NuA1)))
                    || (nu NuG1. (mu MuG1. (Grant1 || <> MuG1)) && ([] NuG1)))
                    && ((! (nu NuA2. (mu MuA2. (Req2 || <> MuA2)) && ([] NuA2)))
                    || (nu NuG2. (mu MuG2. (Grant2 || <> MuG2)) && ([] NuG2)))
                    && ((! (nu NuA3. (mu MuA3. (Req3 || <> MuA3)) && ([] NuA3)))
                    || (nu NuG3. (mu MuG3. (Grant3 || <> MuG3)) && ([] NuG3)))
                    && ((! (nu NuA4. (mu MuA4. (Req4 || <> MuA4)) && ([] NuA4)))
                    || (nu NuG4. (mu MuG4. (Grant4 || <> MuG4)) && ([] NuG4)))
                    && ((! (nu NuA5. (mu MuA5. (Req5 || <> MuA5)) && ([] NuA5)))
                    || (nu NuG5. (mu MuG5. (Grant5 || <> MuG5)) && ([] NuG5)))
                    && ((! (nu NuA6. (mu MuA6. (Req6 || <> MuA6)) && ([] NuA6)))
                    || (nu NuG6. (mu MuG6. (Grant6 || <> MuG6)) && ([] NuG6)))
                    && ((! (nu NuA7. (mu MuA7. (Req7 || <> MuA7)) && ([] NuA7)))
                    || (nu NuG7. (mu MuG7. (Grant7 || <> MuG7)) && ([] NuG7)))
                    && ((! (nu NuA8. (mu MuA8. (Req8 || <> MuA8)) && ([] NuA8)))
                    || (nu NuG8. (mu MuG8. (Grant8 || <> MuG8)) && ([] NuG8)))
                    && ((! (nu NuA9. (mu MuA9. (Req9 || <> MuA9)) && ([] NuA9)))
                    || (nu NuG9. (mu MuG9. (Grant9 || <> MuG9)) && ([] NuG9)));
        }
    }

    controllers {
        controller fair_scheduler {
            source Scheduler;
            satisfying gr1_liveness;
        }
    }
}
