// Address-macro stubs for sv2v + Yosys to parse soc_ifc_pkg. Values are
// placeholder; the boot FSM module does not reference these parameters.
`define CALIPTRA_TOP_REG_MBOX_CSR_BASE_ADDR             32'h0000_0000
`define CALIPTRA_TOP_REG_SHA512_ACC_CSR_BASE_ADDR       32'h0000_1000
`define CALIPTRA_TOP_REG_GENERIC_AND_FUSE_REG_BASE_ADDR 32'h0000_2000
