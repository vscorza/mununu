// memory.ctxdsl — shared memory for the V.4 parametric MESI (N=4).
// Generated by generate.py. Mem_Initial -> Mem_Written on any write
// (the write becomes visible); idempotent on reads.
context Memory {
    automata {
        automaton Memory {
            states {
                state Mem_Initial initial;
                state Mem_Written;
            }
            transitions {
                transition Mem_Initial -> Mem_Written on label xact_write_x_core0;
                transition Mem_Written -> Mem_Written on label xact_write_x_core0;
                transition Mem_Initial -> Mem_Initial on label xact_read_x_core0;
                transition Mem_Written -> Mem_Written on label xact_read_x_core0;
                transition Mem_Initial -> Mem_Written on label xact_write_x_core1;
                transition Mem_Written -> Mem_Written on label xact_write_x_core1;
                transition Mem_Initial -> Mem_Initial on label xact_read_x_core1;
                transition Mem_Written -> Mem_Written on label xact_read_x_core1;
                transition Mem_Initial -> Mem_Written on label xact_write_x_core2;
                transition Mem_Written -> Mem_Written on label xact_write_x_core2;
                transition Mem_Initial -> Mem_Initial on label xact_read_x_core2;
                transition Mem_Written -> Mem_Written on label xact_read_x_core2;
                transition Mem_Initial -> Mem_Written on label xact_write_x_core3;
                transition Mem_Written -> Mem_Written on label xact_write_x_core3;
                transition Mem_Initial -> Mem_Initial on label xact_read_x_core3;
                transition Mem_Written -> Mem_Written on label xact_read_x_core3;
            }
        }
    }
}
