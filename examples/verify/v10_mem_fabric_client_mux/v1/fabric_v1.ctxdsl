            // Every label is environment-driven: the slot arbiter chooses
            // grant/nogrant and sdram_burst chooses accept/refuse. An empty
            // `controllable` block makes the declaration explicit, so every
            // label classifies Uncontrollable instead of defaulting to
            // Controllable.
            controllable { }
