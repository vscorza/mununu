                transition S_IDLE_p0_rx_d0 -> S_IDLE_p0_rx_d0 on label nogrant;
                transition S_IDLE_p0_rx_d0 -> S_IDLE_p0_rx_d0 on label grant, label refuse;
                transition S_IDLE_p0_rx_d0 -> S_IDLE_p1_rx_d1 on label grant, label accept;
                transition S_IDLE_p1_rx_d1 -> S_IDLE_p1_rx_d1 on label nogrant;
                transition S_IDLE_p1_rx_d1 -> S_IDLE_p1_rx_d1 on label grant, label refuse;
                transition S_IDLE_p1_rx_d1 -> S_IDLE_p2_rx_d2 on label grant, label accept;
                transition S_IDLE_p2_rx_d2 -> S_IDLE_p2_rx_d2 on label nogrant;
                transition S_IDLE_p2_rx_d2 -> S_IDLE_p2_rx_d2 on label grant, label refuse;
                transition S_IDLE_p2_rx_d2 -> S_IDLE_p3_rx_d3 on label grant, label accept;
                transition S_IDLE_p3_rx_d3 -> S_IDLE_p3_rx_d3 on label nogrant;
                transition S_IDLE_p3_rx_d3 -> S_IDLE_p3_rx_d3 on label grant, label refuse;
                transition S_IDLE_p3_rx_d3 -> DONE on label grant, label accept;
