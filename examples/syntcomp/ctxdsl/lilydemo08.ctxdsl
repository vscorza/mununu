context syntcomp_lily_demo_v8 {
    alphabet {
        label set_req;
        label clr_req;
        label set_grant;
        label clr_grant;
    }

    automata {
        automaton Signals {
            controllable {
                label set_grant;
                label clr_grant;
            }
            states {
                state v00 initial;
                state v01;
                state v10;
                state v11;
            }
            transitions {
                transition v00 -> v10 on label set_req;
                transition v00 -> v00 on label clr_req;
                transition v00 -> v01 on label set_grant;
                transition v00 -> v00 on label clr_grant;
                transition v01 -> v11 on label set_req;
                transition v01 -> v01 on label clr_req;
                transition v01 -> v01 on label set_grant;
                transition v01 -> v00 on label clr_grant;
                transition v10 -> v10 on label set_req;
                transition v10 -> v00 on label clr_req;
                transition v10 -> v11 on label set_grant;
                transition v10 -> v10 on label clr_grant;
                transition v11 -> v11 on label set_req;
                transition v11 -> v01 on label clr_req;
                transition v11 -> v11 on label set_grant;
                transition v11 -> v10 on label clr_grant;
            }
        }
    }

    mu_formulas {
        formula syntcomp_prop {
            over Signals;
            body = ((! (nu NuG3. ((mu MuF4. ((v10 || v11) || (<> MuF4))) && ([] NuG3))))
            || (nu NuG1. ((mu MuF2. ((v01 || v11) || (<> MuF2))) && ([] NuG1))));
        }
    }

    controllers {
        controller synth {
            source Signals;
            satisfying syntcomp_prop;
        }
    }
}
