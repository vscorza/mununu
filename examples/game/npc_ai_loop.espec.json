{
  "$schema": "extraction_spec_v1",
  "source": {
    "file": "npc_behavior.gd",
    "class": "NPCBehavior"
  },
  "model_config": {
    "context_name": "NPC_AI",
    "uncontrollable_labels": ["ev_enemy_near", "ev_enemy_far", "ev_health_low", "ev_health_ok", "ev_reach_target", "ev_hit"],
    "controllable_labels": ["ev_decide_chase", "ev_decide_retreat", "ev_decide_attack", "ev_decide_patrol"],
    "automata": [
      {
        "id": "AIState",
        "states": [
          { "name": "Patrol", "initial": true },
          { "name": "Chase" },
          { "name": "Attack" },
          { "name": "Retreat" }
        ],
        "controllable_labels": ["ev_decide_chase", "ev_decide_retreat", "ev_decide_attack", "ev_decide_patrol"],
        "transitions": [
          { "from": "Patrol", "to": "Chase", "label": "ev_enemy_near" },
          { "from": "Chase", "to": "Attack", "label": "ev_reach_target" },
          { "from": "Chase", "to": "Retreat", "label": "ev_health_low",
            "comment": "BUG: health_low + enemy_near causes Chase-Retreat oscillation" },
          { "from": "Retreat", "to": "Chase", "label": "ev_enemy_near",
            "comment": "Immediately re-enters Chase when enemy is still nearby" },
          { "from": "Retreat", "to": "Patrol", "label": "ev_enemy_far" },
          { "from": "Attack", "to": "Chase", "label": "ev_hit" },
          { "from": "Attack", "to": "Patrol", "label": "ev_enemy_far" }
        ]
      }
    ],
    "properties": [
      {
        "id": "always_returns_patrol",
        "description": "NPC always eventually returns to Patrol (progress guarantee)",
        "template_ref": { "template": "always_eventually", "args": { "TARGET": "Patrol" } },
        "over": "AIState"
      },
      {
        "id": "attack_reachable",
        "description": "The Attack state is reachable from initial",
        "template_ref": { "template": "reachable", "args": { "TARGET": "Attack" } },
        "over": "AIState"
      },
      {
        "id": "no_ai_deadlock",
        "description": "No AI state is a dead end",
        "template_ref": { "template": "no_deadlock" },
        "over": "AIState"
      }
    ]
  }
}
