{
  "$schema": "extraction_spec_v1",
  "source": {
    "file": "player_controller.gd",
    "class": "PlayerController"
  },
  "model_config": {
    "context_name": "PlayerFSM_Fixed",
    "uncontrollable_labels": ["ev_move", "ev_stop_move", "ev_jump", "ev_attack", "ev_fall", "ev_land", "ev_attack_end", "ev_die"],
    "controllable_labels": ["ev_respawn"],
    "automata": [
      {
        "id": "PlayerState",
        "states": [
          { "name": "Idle", "initial": true },
          { "name": "Running" },
          { "name": "Jumping" },
          { "name": "Falling" },
          { "name": "Attacking" },
          { "name": "Dead" }
        ],
        "controllable_labels": ["ev_respawn"],
        "transitions": [
          { "from": "Idle", "to": "Running", "label": "ev_move" },
          { "from": "Idle", "to": "Jumping", "label": "ev_jump" },
          { "from": "Idle", "to": "Attacking", "label": "ev_attack" },
          { "from": "Running", "to": "Idle", "label": "ev_stop_move" },
          { "from": "Running", "to": "Jumping", "label": "ev_jump" },
          { "from": "Jumping", "to": "Falling", "label": "ev_fall" },
          { "from": "Falling", "to": "Idle", "label": "ev_land" },
          { "from": "Attacking", "to": "Idle", "label": "ev_attack_end" },
          { "from": "Idle", "to": "Dead", "label": "ev_die" },
          { "from": "Running", "to": "Dead", "label": "ev_die" },
          { "from": "Jumping", "to": "Dead", "label": "ev_die" },
          { "from": "Falling", "to": "Dead", "label": "ev_die" },
          { "from": "Attacking", "to": "Dead", "label": "ev_die" },
          { "from": "Dead", "to": "Idle", "label": "ev_respawn" }
        ]
      }
    ],
    "properties": [
      {
        "id": "no_softlock",
        "description": "No state is a dead end — every state has at least one outgoing transition",
        "template_ref": { "template": "no_deadlock" },
        "over": "PlayerState",
        "holds_in_fixed": true
      },
      {
        "id": "can_return_idle",
        "description": "From every state, Idle is always eventually reachable",
        "template_ref": { "template": "always_eventually", "args": { "TARGET": "Idle" } },
        "over": "PlayerState"
      }
    ]
  }
}
