INFO { TITLE: "arbiter3"; DESCRIPTION: "3-client mutex + no-starvation"; SEMANTICS: Mealy; TARGET: Mealy; }
MAIN {
  INPUTS { req_0; req_1; req_2; }
  OUTPUTS { grant_0; grant_1; grant_2; }
  ASSUMPTIONS { G F req_0; G F req_1; G F req_2; }
  GUARANTEES {
    G (!(grant_0 && grant_1));
    G (!(grant_0 && grant_2));
    G (!(grant_1 && grant_2));
    G (req_0 -> F grant_0);
    G (req_1 -> F grant_1);
    G (req_2 -> F grant_2);
  }
}
