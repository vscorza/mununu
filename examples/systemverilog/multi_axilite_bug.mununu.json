{
  "$schema": "mununu_sv_multi_v1",
  "modules": [
    {
      "name": "axilite_master",
      "source": "multi_axilite_master.sv",
      "clock_domain": "clk",
      "signals": [
        {"name": "state", "abstraction": "enum", "variants": ["IDLE", "ISSUED", "BACKPRESSURE"]}
      ],
      "inputs": [
        {"name": "start", "abstraction": "boolean"},
        {"name": "ready_delay", "abstraction": "boolean"}
      ],
      "controllable": []
    },
    {
      "name": "axilite_slave_bug",
      "source": "multi_axilite_slave_bug.sv",
      "clock_domain": "clk",
      "signals": [
        {"name": "state", "abstraction": "enum", "variants": ["IDLE", "ACTIVE", "RESPOND"]},
        {"name": "bvalid_r", "abstraction": "boolean"},
        {"name": "pending", "abstraction": "boolean"}
      ],
      "inputs": [],
      "controllable": []
    }
  ],
  "connections": [
    {
      "from": "axilite_master.awvalid",
      "to": "axilite_slave_bug.awvalid",
      "abstraction": "boolean",
      "note": "Write address valid"
    },
    {
      "from": "axilite_master.wvalid",
      "to": "axilite_slave_bug.wvalid",
      "abstraction": "boolean",
      "note": "Write data valid"
    },
    {
      "from": "axilite_master.bready",
      "to": "axilite_slave_bug.bready",
      "abstraction": "boolean",
      "note": "Response ready (backpressure when low)"
    },
    {
      "from": "axilite_slave_bug.bvalid",
      "to": "axilite_master.bvalid",
      "abstraction": "boolean",
      "note": "Response valid from slave"
    }
  ],
  "composition": {
    "mode": "synchronous",
    "name": "axi_system"
  },
  "properties": [
    {
      "id": "no_deadlock",
      "formula": "nu X. ([] X)",
      "description": "Composed system has no deadlock"
    },
    {
      "id": "no_response_drop",
      "formula": "nu X. ((!pending_T || state_RESPOND) && [] X)",
      "description": "If pending is true, slave must be in RESPOND (never leaves RESPOND with pending still set)"
    }
  ]
}
