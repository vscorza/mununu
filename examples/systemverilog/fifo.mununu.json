{
  "$schema": "mununu_sv_annotation_v1",
  "module": "fifo",
  "source": "fifo.sv",
  "signals": [
    {
      "name": "state",
      "abstraction": "enum",
      "variants": [
        "IDLE",
        "WRITING",
        "READING",
        "RDWR"
      ],
      "note": "auto-detected typedef enum"
    },
    {
      "name": "fill",
      "abstraction": "bounded_counter",
      "bound": 7,
      "note": "small register — bounded counter"
    },
    {
      "name": "data_out_r",
      "preserve": false,
      "abstraction": "discover",
      "note": "wide register — run `mununu sv discover` to find significant values"
    }
  ],
  "inputs": [
    {
      "name": "wr_en",
      "abstraction": "boolean"
    },
    {
      "name": "rd_en",
      "abstraction": "boolean"
    },
    {
      "name": "data_in",
      "abstraction": "discover"
    }
  ],
  "properties": [
    {
      "id": "safety",
      "formula": "nu X. ([] X)",
      "description": "No deadlock — all states have successors"
    }
  ],
  "parameters": {
    "DEPTH": 4
  }
}