{
  "$schema": "mununu_sv_multi_v1",
  "modules": [
    {
      "name": "axilite_write_master",
      "source": "axilite_write_master.sv",
      "clock_domain": "clk",
      "signals": [
        {"name": "state", "abstraction": "enum", "variants": ["M_IDLE", "M_ADDR_DATA", "M_WAIT_RESP", "M_RESP_DELAY", "M_RESP_ACK"]}
      ],
      "inputs": [
        {"name": "cmd_write", "abstraction": "boolean"},
        {"name": "cmd_slow_resp", "abstraction": "boolean"}
      ],
      "controllable": []
    },
    {
      "name": "axilite_write_slave_xilinx_bug",
      "source": "axilite_write_slave_xilinx_bug.sv",
      "clock_domain": "clk",
      "signals": [
        {"name": "axi_awready", "abstraction": "boolean"},
        {"name": "axi_wready", "abstraction": "boolean"},
        {"name": "axi_bvalid", "abstraction": "boolean"},
        {"name": "aw_flag", "abstraction": "boolean"}
      ],
      "inputs": [],
      "controllable": []
    }
  ],
  "connections": [
    {
      "from": "axilite_write_master.m_axi_awvalid",
      "to": "axilite_write_slave_xilinx_bug.s_axi_awvalid",
      "abstraction": "boolean",
      "note": "Write address valid: master → slave"
    },
    {
      "from": "axilite_write_master.m_axi_wvalid",
      "to": "axilite_write_slave_xilinx_bug.s_axi_wvalid",
      "abstraction": "boolean",
      "note": "Write data valid: master → slave"
    },
    {
      "from": "axilite_write_master.m_axi_bready",
      "to": "axilite_write_slave_xilinx_bug.s_axi_bready",
      "abstraction": "boolean",
      "note": "Response ready: master → slave (backpressure when low)"
    },
    {
      "from": "axilite_write_slave_xilinx_bug.s_axi_awready",
      "to": "axilite_write_master.m_axi_awready",
      "abstraction": "boolean",
      "note": "Address ready: slave → master"
    },
    {
      "from": "axilite_write_slave_xilinx_bug.s_axi_wready",
      "to": "axilite_write_master.m_axi_wready",
      "abstraction": "boolean",
      "note": "Write ready: slave → master"
    },
    {
      "from": "axilite_write_slave_xilinx_bug.s_axi_bvalid",
      "to": "axilite_write_master.m_axi_bvalid",
      "abstraction": "boolean",
      "note": "Response valid: slave → master"
    }
  ],
  "composition": {
    "mode": "synchronous",
    "name": "axi_write_system"
  },
  "properties": [
    {
      "id": "no_deadlock",
      "formula": "nu X. ([] X)",
      "description": "System never deadlocks"
    },
    {
      "id": "no_response_window",
      "formula": "nu X. ((! aw_flag_F_axi_awready_F_axi_bvalid_T_axi_wready_F) && [] X)",
      "description": "The orphan-response state (aw_flag=F while axi_bvalid=T — slave reports response pending but flag claims it has accepted no write) is unreachable. Bug composition: state IS reachable because the slave clears aw_flag on data acceptance, allowing a new awvalid before response is acked. Fixed composition: state is unreachable because flag clears only on bvalid+bready."
    }
  ]
}
