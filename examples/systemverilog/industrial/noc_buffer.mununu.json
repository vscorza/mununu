      "abstraction": "boolean",
      "combinational": true,
      "note": "combinational output (assign-driven)"
    },
    {
      "name": "empty",
      "abstraction": "boolean",
      "combinational": true,
      "note": "combinational output (assign-driven)"
    }
  ],
  "inputs": [
    {
      "name": "push",
      "abstraction": "boolean"
    },
    {
      "name": "pop",
      "abstraction": "boolean"
    }
  ],
  "properties": [
    {
      "id": "safety",
