        },
        {
          "name": "s_axi_awready",
          "abstraction": "boolean",
          "combinational": true,
          "note": "combinational output"
        },
        {
          "name": "s_axi_wready",
          "abstraction": "boolean",
          "combinational": true,
          "note": "combinational output"
        },
        {
          "name": "s_axi_bvalid",
          "abstraction": "boolean",
          "combinational": true,
          "note": "combinational output"
        }
      ]
    }
