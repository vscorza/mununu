  "composition": {
    "mode": "synchronous",
    "name": "system"
  },
  "properties": [
    {
      "id": "safety",
      "formula": "nu X. ([] X)",
      "description": "No deadlock — all states have successors"
    },
    {
      "id": "no_response_window",
      "formula": "nu X. ((!axi_bvalid_T || aw_flag_T) && [] X)",
      "description": "When bvalid is high, aw_flag must also be high (no new writes during pending response)"
    }
  ]
