  "connections": [
    {
      "from": "axilite_write_master.m_axi_wvalid",
      "to": "axilite_write_slave_xilinx_bug.s_axi_wvalid",
      "abstraction": "boolean",
      "note": "wire 'wvalid': master_inst.m_axi_wvalid → slave_inst.s_axi_wvalid"
    },
    {
      "from": "axilite_write_master.m_axi_bready",
      "to": "axilite_write_slave_xilinx_bug.s_axi_bready",
      "abstraction": "boolean",
      "note": "wire 'bready': master_inst.m_axi_bready → slave_inst.s_axi_bready"
    },
    {
      "from": "axilite_write_slave_xilinx_bug.s_axi_awready",
      "to": "axilite_write_master.m_axi_awready",
      "abstraction": "boolean",
      "note": "wire 'awready': slave_inst.s_axi_awready → master_inst.m_axi_awready"
    },
    {
      "from": "axilite_write_slave_xilinx_bug.s_axi_wready",
      "to": "axilite_write_master.m_axi_wready",
      "abstraction": "boolean",
      "note": "wire 'wready': slave_inst.s_axi_wready → master_inst.m_axi_wready"
    },
    {
      "from": "axilite_write_master.m_axi_awvalid",
      "to": "axilite_write_slave_xilinx_bug.s_axi_awvalid",
