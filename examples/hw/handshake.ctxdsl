// Req/Ack Handshake Protocol (from hw-verification-uba lab01)
//
// 4-state FSM modeling a request/acknowledge handshake with latency.
// The environment controls the `req` signal; the controller manages
// ack assertion and state transitions.
//
// Protocol:
//   1. Environment asserts req (IDLE -> WAIT_ACK)
//   2. Controller counts latency cycles (WAIT_ACK ticks)
//   3. Controller asserts ack (WAIT_ACK -> ACTIVE)
//   4. Environment deasserts req (ACTIVE -> DONE)
//   5. Controller deasserts ack, returns to IDLE (DONE -> IDLE)

context handshake {
    alphabet {
        label req_assert;
        label req_deassert;
        label latency_tick;
        label ack_assert;
        label ack_deassert;
    }

    automata {
        automaton Handshake {
            controllable {
                label ack_assert;
                label ack_deassert;
                label latency_tick;
            }

            states {
                state Idle initial;
                state WaitAck;
                state Active;
                state Done;
            }

            transitions {
                // Environment raises request
                transition Idle -> WaitAck on label req_assert;
                // Idle self-loop: no request yet
                transition Idle -> Idle on label latency_tick;

                // Controller counts latency cycles
                transition WaitAck -> WaitAck on label latency_tick;
                // Controller asserts ack after latency
                transition WaitAck -> Active on label ack_assert;

                // Active: ack held high, waiting for req deassert
                transition Active -> Done on label req_deassert;

                // Done: controller deasserts ack, return to idle
                transition Done -> Idle on label ack_deassert;
            }
        }
    }

    // Safety and reachability properties derived from lab01 props.sv assertions.

    mu_formulas {
        // Safety: the system always remains in a valid state.
        // nu X. ([] X) — invariant: every reachable state satisfies X,
        // which is trivially true for all states in this well-formed automaton.
        formula safety_invariant {
            over Handshake;
            body = nu X. ([] X);
        }

        // Reachability: Active state (ack asserted) is reachable from Idle.
        // mu X. (Active || <> X) — there exists a path to Active.
        formula ack_reachable {
            over Handshake;
            body = mu X. (Active || <> X);
        }

        // Reachability: the protocol can complete a full cycle back to Idle.
        // mu X. (Idle || <> X) — Idle is reachable from any state.
        formula cycle_completes {
            over Handshake;
            body = mu X. (Idle || <> X);
        }

        // Liveness: from Active, Done is reachable (ack can be deasserted).
        // Checks that the Active state is not a dead end.
        formula active_can_complete {
            over Handshake;
            body = (! Active) || (mu Y. (Done || <> Y));
        }
    }

    controllers {
        controller handshake_safety {
            source Handshake;
            satisfying safety_invariant;
        }
    }
}
