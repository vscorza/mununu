// Properties for Handshake Protocol
//
// Safety and reachability properties derived from lab01 props.sv assertions.

context handshake_properties {
    mu_formulas {
        // Safety: the system always remains in a valid state.
        // nu X. ([] X) — invariant: every reachable state satisfies X,
        // which is trivially true for all states in this well-formed automaton.
        formula safety_invariant {
            over Handshake;
            body = nu X. ([] X);
        }

        // Reachability: Active state (ack asserted) is reachable from Idle.
        // mu X. (Active || <> X) — there exists a path to Active.
        formula ack_reachable {
            over Handshake;
            body = mu X. (Active || <> X);
        }

        // Reachability: the protocol can complete a full cycle back to Idle.
        // mu X. (Idle || <> X) — Idle is reachable from any state.
        formula cycle_completes {
            over Handshake;
            body = mu X. (Idle || <> X);
        }

        // Liveness: from Active, Done is reachable (ack can be deasserted).
        // Checks that the Active state is not a dead end.
        formula active_can_complete {
            over Handshake;
            body = (! Active) || (mu Y. (Done || <> Y));
        }
    }

    controllers {
        controller handshake_safety {
            source Handshake;
            satisfying safety_invariant;
        }
    }
}
