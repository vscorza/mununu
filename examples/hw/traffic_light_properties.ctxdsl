// Properties for Traffic Light Controller
//
// Safety and liveness properties derived from lab05 props.sv assertions.

context traffic_light_properties {
    mu_formulas {
        // Safety invariant: the system is always in a valid state.
        formula safety_invariant {
            over TrafficLight;
            body = nu X. ([] X);
        }

        // Reachability: all states are reachable from Green.
        formula yellow_reachable {
            over TrafficLight;
            body = mu X. (Yellow || <> X);
        }

        formula red_reachable {
            over TrafficLight;
            body = mu X. (Red || <> X);
        }

        formula red_wait_reachable {
            over TrafficLight;
            body = mu X. (RedWait || <> X);
        }

        // Full cycle: Green is reachable from any state.
        formula full_cycle {
            over TrafficLight;
            body = mu X. (Green || <> X);
        }

        // Valid transitions: from Green, only Yellow is the next phase.
        // Expressed as: if we are in Green, a timer_expire leads to Yellow.
        formula green_to_yellow {
            over TrafficLight;
            body = (! Green) || < labels = { timer_expire } > Yellow;
        }

        // Valid transitions: from Yellow, timer_expire leads to Red.
        formula yellow_to_red {
            over TrafficLight;
            body = (! Yellow) || < labels = { timer_expire } > Red;
        }
    }

    controllers {
        controller safe_traffic {
            source TrafficLight;
            satisfying safety_invariant;
        }
    }
}
