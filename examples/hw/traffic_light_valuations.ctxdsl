// Traffic Light Controller — valuations-decorated variant
//
// Same automaton as `traffic_light.ctxdsl`, but every state declares a
// `valuations { ... }` block carrying the structured signal values that
// the BTOR2 reader emits when the model is built from
// `examples/btor2/traffic_light.sv`. Verdicts are identical (the model
// checker only sees state names and transitions); the valuations exist
// purely to enrich counterexample / counterstrategy traces and to give
// downstream consumers (the trace renderer, the UI graph view) the same
// structured data they would have received from a Yosys/BTOR2 run —
// without needing Yosys installed.
//
// This is the canonical worked example for the `valuations { ... }`
// grammar landed in Phase 1 of the state-valuation feature.

context traffic_light {
    alphabet {
        label timer_tick;
        label timer_expire;
        label sensor_trigger;
    }

    automata {
        automaton TrafficLight {
            controllable {
                label timer_expire;
            }

            states {
                state Green initial {
                    valuations {
                        is_red = 0;
                        is_green = 1;
                        is_yellow = 0;
                        phase = green;
                    }
                };
                state Yellow {
                    valuations {
                        is_red = 0;
                        is_green = 0;
                        is_yellow = 1;
                        phase = yellow;
                    }
                };
                state Red {
                    valuations {
                        is_red = 1;
                        is_green = 0;
                        is_yellow = 0;
                        phase = red;
                    }
                };
                state RedWait {
                    valuations {
                        is_red = 1;
                        is_green = 0;
                        is_yellow = 0;
                        phase = red_wait;
                    }
                };
            }

            transitions {
                // GREEN phase: timer counts down
                transition Green -> Green on label timer_tick;
                transition Green -> Yellow on label timer_expire;

                // YELLOW phase: timer counts down
                transition Yellow -> Yellow on label timer_tick;
                transition Yellow -> Red on label timer_expire;

                // RED phase: timer counts down
                transition Red -> Red on label timer_tick;
                transition Red -> RedWait on label timer_expire;

                // RED_WAIT: waiting for sensor (environment input)
                transition RedWait -> Green on label sensor_trigger;
                transition RedWait -> RedWait on label timer_tick;
            }
        }
    }

    mu_formulas {
        formula safety_invariant {
            over TrafficLight;
            body = nu X. ([] X);
        }

        formula yellow_reachable {
            over TrafficLight;
            body = mu X. (Yellow || <> X);
        }

        formula red_reachable {
            over TrafficLight;
            body = mu X. (Red || <> X);
        }

        formula red_wait_reachable {
            over TrafficLight;
            body = mu X. (RedWait || <> X);
        }

        formula full_cycle {
            over TrafficLight;
            body = mu X. (Green || <> X);
        }

        formula green_to_yellow {
            over TrafficLight;
            body = (! Green) || < labels = { timer_expire } > Yellow;
        }

        formula yellow_to_red {
            over TrafficLight;
            body = (! Yellow) || < labels = { timer_expire } > Red;
        }
    }

    controllers {
        controller safe_traffic {
            source TrafficLight;
            satisfying safety_invariant;
        }
    }
}
