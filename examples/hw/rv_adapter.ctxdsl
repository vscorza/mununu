// Ready/Valid Adapter with Skid Buffer (from hw-verification-uba lab09)
//
// 2-state FSM that converts a simple valid-only producer to a
// ready/valid (backpressured) consumer interface using a skid buffer.
//
// When the consumer deasserts ready while data is valid, the adapter
// captures the data in a buffer (EMPTY -> FULL). When ready reasserts,
// the buffered data is sent (FULL -> EMPTY).
//
// The environment controls in_valid and out_ready signals.

context rv_adapter {
    alphabet {
        label push;
        label drain;
        label passthrough;
        label idle;
    }

    automata {
        automaton RvAdapter {
            controllable {
                label push;
                label drain;
                label passthrough;
            }

            states {
                state Empty initial;
                state Full;
            }

            transitions {
                // EMPTY state: buffer is empty
                // Passthrough: data flows directly (valid && ready)
                transition Empty -> Empty on label passthrough;
                // Push: data captured in buffer (valid && !ready)
                transition Empty -> Full on label push;
                // Idle: no data (no valid)
                transition Empty -> Empty on label idle;

                // FULL state: buffer holds data
                // Drain: consumer accepts buffered data (ready asserted)
                transition Full -> Empty on label drain;
                // Stay full if consumer not ready
                transition Full -> Full on label idle;
            }
        }
    }

    // Protocol correctness properties derived from lab09 props.sv assertions.

    mu_formulas {
        // Safety invariant: the adapter is always in a valid state.
        formula safety_invariant {
            over RvAdapter;
            body = nu X. ([] X);
        }

        // Reachability: the Full state is reachable (buffer can be used).
        formula buffer_reachable {
            over RvAdapter;
            body = mu X. (Full || <> X);
        }

        // Full cycle: the adapter can always return to Empty from any state.
        formula cycle_completes {
            over RvAdapter;
            body = mu X. (Empty || <> X);
        }

        // Drain: from Full, Empty is reachable (buffer can be drained).
        formula drain_possible {
            over RvAdapter;
            body = (! Full) || (mu Y. (Empty || <> Y));
        }

        // Push: from Empty, Full is reachable (buffer can capture data).
        formula push_possible {
            over RvAdapter;
            body = (! Empty) || (mu Y. (Full || <> Y));
        }
    }

    controllers {
        controller safe_adapter {
            source RvAdapter;
            satisfying safety_invariant;
        }
    }
}
