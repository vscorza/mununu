// Traffic Light Controller (from hw-verification-uba lab05)
//
// 4-state FSM with timer-driven transitions. The light cycles through
// GREEN -> YELLOW -> RED -> RED_WAIT, then waits for a sensor signal
// before returning to GREEN.
//
// The environment controls the sensor; the controller manages the
// light state and timer. Timer expiration is modeled as a label.

context traffic_light {
    alphabet {
        label timer_tick;
        label timer_expire;
        label sensor_trigger;
    }

    automata {
        automaton TrafficLight {
            controllable {
                label timer_expire;
            }

            states {
                state Green initial;
                state Yellow;
                state Red;
                state RedWait;
            }

            transitions {
                // GREEN phase: timer counts down
                transition Green -> Green on label timer_tick;
                transition Green -> Yellow on label timer_expire;

                // YELLOW phase: timer counts down
                transition Yellow -> Yellow on label timer_tick;
                transition Yellow -> Red on label timer_expire;

                // RED phase: timer counts down
                transition Red -> Red on label timer_tick;
                transition Red -> RedWait on label timer_expire;

                // RED_WAIT: waiting for sensor (environment input)
                transition RedWait -> Green on label sensor_trigger;
                // Stay in RedWait if no sensor
                transition RedWait -> RedWait on label timer_tick;
            }
        }
    }

    // Safety and liveness properties derived from lab05 props.sv assertions.

    mu_formulas {
        // Safety invariant: the system is always in a valid state.
        formula safety_invariant {
            over TrafficLight;
            body = nu X. ([] X);
        }

        // Reachability: all states are reachable from Green.
        formula yellow_reachable {
            over TrafficLight;
            body = mu X. (Yellow || <> X);
        }

        formula red_reachable {
            over TrafficLight;
            body = mu X. (Red || <> X);
        }

        formula red_wait_reachable {
            over TrafficLight;
            body = mu X. (RedWait || <> X);
        }

        // Full cycle: Green is reachable from any state.
        formula full_cycle {
            over TrafficLight;
            body = mu X. (Green || <> X);
        }

        // Valid transitions: from Green, only Yellow is the next phase.
        // Expressed as: if we are in Green, a timer_expire leads to Yellow.
        formula green_to_yellow {
            over TrafficLight;
            body = (! Green) || < labels = { timer_expire } > Yellow;
        }

        // Valid transitions: from Yellow, timer_expire leads to Red.
        formula yellow_to_red {
            over TrafficLight;
            body = (! Yellow) || < labels = { timer_expire } > Red;
        }
    }

    controllers {
        controller safe_traffic {
            source TrafficLight;
            satisfying safety_invariant;
        }
    }
}
