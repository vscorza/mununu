// Tutorial 03a — Synchronous Composition
//
// System: Producer-consumer pipeline with shared clock
//
// In synchronous composition, both automata take a step simultaneously
// on every clock cycle. Shared labels (those in both automata) must
// fire together. Non-shared labels combine freely when both sides move.
//
// Each automaton needs its own "skip" label (p_skip, c_skip) so it
// can do nothing while the other side acts — shared idle labels would
// force both to idle simultaneously.
//
// Introduces: composition, synchronous, members.

context sync_producer_consumer {
    automata {
        automaton Producer {
            controllable {
                label produce;
            }

            states {
                state Empty initial;
                state DataReady;
            }

            transitions {
                // Produce data
                transition Empty -> DataReady on label produce;
                // Transfer data to consumer (shared label — must sync)
                transition DataReady -> Empty on label transfer;
                // Skip: producer does nothing this cycle
                transition Empty -> Empty on label p_skip;
                transition DataReady -> DataReady on label p_skip;
            }
        }

        automaton Consumer {
            controllable {
                label consume;
            }

            states {
                state Waiting initial;
                state Processing;
            }

            transitions {
                // Receive data via transfer (shared label — must sync)
                transition Waiting -> Processing on label transfer;
                // Finish processing
                transition Processing -> Waiting on label consume;
                // Skip: consumer does nothing this cycle
                transition Waiting -> Waiting on label c_skip;
                transition Processing -> Processing on label c_skip;
            }
        }
    }

    composition {
        synchronous pipeline {
            members [Producer, Consumer];
        }
    }

    mu_formulas {
        // Safety over the composed system (structural — no state names needed)
        formula safety_invariant {
            over pipeline;
            body = nu X. ([] X);
        }

        // No deadlocks: every reachable state has a successor
        formula no_deadlock {
            over pipeline;
            body = nu X. ((<> true) && ([] X));
        }

        // Properties over individual automata (state predicates work here)
        formula producer_can_produce {
            over Producer;
            body = mu X. (DataReady || <> X);
        }

        formula consumer_processes {
            over Consumer;
            body = mu X. (Processing || <> X);
        }

        formula producer_cycles {
            over Producer;
            body = mu X. (Empty || <> X);
        }
    }
}
