// Tutorial 02a — Single-Label Transitions
//
// System: SPI (Serial Peripheral Interface) master controller
//
// Each transition carries exactly one signal event, modeling the
// sequential SPI protocol: assert chip-select, clock data bits,
// then deassert chip-select.
//
// Introduces: controllable labels, controllers, controller synthesis.

context spi_master {
    alphabet {
        label cs_assert;
        label cs_deassert;
        label sclk_tick;
        label mosi_write;
        label done;
    }

    automata {
        automaton SpiMaster {
            controllable {
                label cs_assert;
                label cs_deassert;
                label sclk_tick;
                label mosi_write;
                label done;
            }

            states {
                state Idle initial;
                state Selected;
                state Shifting;
                state Complete;
            }

            transitions {
                // Assert chip-select to begin transaction
                transition Idle -> Selected on label cs_assert;
                // Idle self-loop when no transaction pending
                transition Idle -> Idle on label done;

                // Begin shifting data
                transition Selected -> Shifting on label mosi_write;

                // Clock additional data bits
                transition Shifting -> Shifting on label sclk_tick;
                // Finish shifting
                transition Shifting -> Complete on label done;

                // Deassert chip-select after transfer complete
                transition Complete -> Idle on label cs_deassert;
            }
        }
    }

    mu_formulas {
        // Safety: the SPI master always stays in a valid state
        formula safety_invariant {
            over SpiMaster;
            body = nu X. ([] X);
        }

        // Reachability: Complete state is reachable (transfer can finish)
        formula transfer_completes {
            over SpiMaster;
            body = mu X. (Complete || <> X);
        }

        // Labeled modality: from Idle, cs_assert leads to Selected
        formula cs_leads_to_selected {
            over SpiMaster;
            body = (! Idle) || < labels = { cs_assert } > Selected;
        }

        // Cycle: from any state, Idle is reachable (can always return)
        formula returns_to_idle {
            over SpiMaster;
            body = mu X. (Idle || <> X);
        }
    }

    controllers {
        controller spi_safety {
            source SpiMaster;
            satisfying safety_invariant;
        }
    }
}
