// Tutorial 13 — Liveness Counterexample
//
// System: Heartbeat monitor
//
// A monitor expects periodic heartbeats from a device. The device
// can send heartbeats (uncontrollable) or the timer can tick
// (uncontrollable). The controller can only reset after receiving
// a heartbeat.
//
// The liveness property "Received is visited infinitely often"
// fails because the environment can loop tick at Waiting forever,
// never sending a heartbeat.
//
// Demonstrates: liveness counterexamples and the distinction
// between existential reachability (some path) and controllable
// inevitability (all paths under controller's strategy).
//
// NOTE: Current counterexample traces are finite prefixes.
// A complete liveness counterexample would be a lasso (prefix + cycle)
// showing the infinite path that avoids Received.

context heartbeat_monitor {
    alphabet {
        label heartbeat;
        label tick;
        label reset;
        label alarm;
    }

    automata {
        automaton Monitor {
            // Controller can only reset and trigger alarm.
            // heartbeat and tick are environment events.
            controllable {
                label reset;
                label alarm;
            }

            states {
                state Waiting initial;
                state Received;
                state Timeout;
            }

            transitions {
                // Device sends heartbeat (uncontrollable)
                transition Waiting -> Received on label heartbeat;
                // Timer ticks (uncontrollable)
                transition Waiting -> Waiting on label tick;
                // After enough ticks without heartbeat, timeout
                transition Waiting -> Timeout on label alarm;
                // Controller resets after receiving heartbeat
                transition Received -> Waiting on label reset;
                // Timeout: controller triggers alarm and resets
                transition Timeout -> Waiting on label reset;
            }
        }
    }

    mu_formulas {
        // === FAILS: Controller can force reaching Received ===
        // The environment can loop tick at Waiting forever.
        formula ctrl_force_received {
            over Monitor;
            body = mu X. (Received || [ (ctrl = controllable) ] X);
        }

        // === Environment counterstrategy ===
        // Environment wins from {Waiting, Timeout}: loop tick forever.
        formula env_prevents_received {
            over Monitor;
            body = nu X. ((!Received) && < (ctrl = environment) > X);
        }

        // === Existential: Received IS reachable (if env cooperates) ===
        formula received_reachable {
            over Monitor;
            body = mu X. (Received || <> X);
        }

        // === GF pattern: Received infinitely often ===
        // Uses standard mu-calculus GF encoding.
        // This is the LIVENESS property that would need a lasso
        // counterexample to explain its failure.
        formula gf_received {
            over Monitor;
            body = nu X. ((mu Y. (Received || <> Y)) && ([] X));
        }

        // Safety: all states are valid
        formula safety {
            over Monitor;
            body = nu X. ([] X);
        }
    }

    controllers {
        // Controller for safety (trivially realizable)
        controller safe_monitor {
            source Monitor;
            satisfying safety;
            diagnostics {
                counterexample = true;
                deadlock_traces = true;
            }
        }
    }
}
