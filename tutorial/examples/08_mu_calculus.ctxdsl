// Tutorial 08 — Mu-Calculus Elements
//
// System: Token ring with 3 nodes
//
// A token circulates among three nodes. Each node can process locally
// when holding the token, then pass it to the next node.
//
// This example showcases ALL mu-calculus operators in mununu:
//   nu X. phi  — greatest fixpoint (safety/invariance)
//   mu X. phi  — least fixpoint (reachability/liveness)
//   [] phi     — box: ALL successors satisfy phi
//   <> phi     — diamond: SOME successor satisfies phi
//   [ labels = {a} ] phi — labeled box: all a-transitions satisfy phi
//   < labels = {a} > phi — labeled diamond: some a-transition satisfies phi
//   phi && psi — conjunction
//   phi || psi — disjunction
//   ! phi      — negation
//   true/false — constants
//
// Introduces: comprehensive mu-calculus syntax and common formula patterns.

context mu_calculus_showcase {
    alphabet {
        label pass_01;
        label pass_12;
        label pass_20;
        label process;
    }

    automata {
        automaton TokenRing {
            controllable {
                label pass_01;
                label pass_12;
                label pass_20;
                label process;
            }

            states {
                state Node0 initial;
                state Node1;
                state Node2;
                state Proc0;
                state Proc1;
                state Proc2;
            }

            transitions {
                // Token passing: node -> next node
                transition Node0 -> Node1 on label pass_01;
                transition Node1 -> Node2 on label pass_12;
                transition Node2 -> Node0 on label pass_20;

                // Local processing: node -> processing -> node
                transition Node0 -> Proc0 on label process;
                transition Proc0 -> Node0 on label process;
                transition Node1 -> Proc1 on label process;
                transition Proc1 -> Node1 on label process;
                transition Node2 -> Proc2 on label process;
                transition Proc2 -> Node2 on label process;
            }
        }
    }

    mu_formulas {
        // === Greatest fixpoint (nu) — Safety/Invariance ===

        // nu X. ([] X) — "all reachable states are valid"
        // The canonical safety invariant.
        formula safety_invariant {
            over TokenRing;
            body = nu X. ([] X);
        }

        // === Least fixpoint (mu) — Reachability ===

        // mu X. (Node2 || <> X) — "Node2 is reachable from here"
        // Computes the set of states from which Node2 can be reached.
        formula node2_reachable {
            over TokenRing;
            body = mu X. (Node2 || <> X);
        }

        // === Labeled box modality ===

        // [ labels = { pass_01 } ] Node1
        // "Every pass_01 transition leads to Node1"
        // True for all states (pass_01 only exists from Node0 -> Node1).
        formula pass01_leads_to_node1 {
            over TokenRing;
            body = [ labels = { pass_01 } ] Node1;
        }

        // === Labeled diamond modality ===

        // < labels = { pass_12 } > Node2
        // "There exists a pass_12 transition leading to Node2"
        // True only for Node1 (the only state with a pass_12 transition).
        formula can_pass_to_node2 {
            over TokenRing;
            body = < labels = { pass_12 } > Node2;
        }

        // === Nested fixpoints — GF pattern ===

        // nu X. (mu Y. (Node0 || <> Y)) && ([] X)
        // "Infinitely often Node0" (GF Node0)
        // From every reachable state, Node0 can always be reached again.
        formula gf_node0 {
            over TokenRing;
            body = nu X. ((mu Y. (Node0 || <> Y)) && ([] X));
        }

        // === Conjunction and disjunction ===

        // (Node0 || Node1 || Node2) — "holding the token (not processing)"
        formula holding_token {
            over TokenRing;
            body = Node0 || Node1 || Node2;
        }

        // === Negation ===

        // ! Proc0 — "not in processing state at node 0"
        formula not_processing_0 {
            over TokenRing;
            body = ! Proc0;
        }

        // === Combined: always eventually some node holds the token ===

        // nu X. (mu Y. (Node0 || Node1 || Node2 || <> Y)) && ([] X)
        formula always_token_returns {
            over TokenRing;
            body = nu X. ((mu Y. (Node0 || Node1 || Node2 || <> Y)) && ([] X));
        }

        // === Box over all transitions ===

        // From Proc0, ALL transitions lead to Node0
        formula proc0_returns_to_node0 {
            over TokenRing;
            body = (! Proc0) || ([] Node0);
        }

        // === Diamond over all transitions ===

        // From Node0, SOME transition leads to Node1 (via pass_01)
        formula node0_can_reach_node1 {
            over TokenRing;
            body = (! Node0) || (<> Node1);
        }

        // === Controllability-aware modality ===

        // [ (ctrl = controllable) ] X — the game-theoretic box:
        //   ALL uncontrollable transitions must satisfy X
        //   At least ONE controllable transition must satisfy X
        //
        // In this example all labels are controllable, so this is
        // equivalent to <> X (existential). See tutorials 05 and 06
        // for examples where controllable/uncontrollable distinction
        // produces different results.
        formula ctrl_reach_node2 {
            over TokenRing;
            body = mu X. (Node2 || [ (ctrl = controllable) ] X);
        }
    }
}
