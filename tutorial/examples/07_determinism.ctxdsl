// Tutorial 07 — Determinism vs Non-Determinism
//
// System: Two versions of a request-acknowledge protocol
//
// DeterministicProtocol: each (state, label) pair has exactly one target.
// NondeterministicProtocol: from NdPending, `nd_ack` leads to TWO states.
//
// Key insight: nondeterminism on a label means the OUTCOME cannot be
// controlled by either player. Mununu's Skolem paradigm treats all
// transitions sharing the same label as "all outcomes must satisfy"
// regardless of box/diamond. The controllability of the label determines
// WHO can trigger the action, but nondeterminism means the outcome
// is unpredictable once triggered.
//
// This example shows how controllability of the nondeterministic label
// affects reachability: when nd_ack is controllable, the system can
// choose NOT to trigger it (avoiding the uncertain outcome). When
// uncontrollable, the environment forces it.

context determinism_demo {
    automata {
        // Deterministic version: fully predictable
        automaton DeterministicProtocol {
            controllable {
                label det_req;
                label det_ack;
                label det_reset;
            }

            states {
                state DetIdle initial;
                state DetPending;
                state DetDone;
            }

            transitions {
                transition DetIdle -> DetPending on label det_req;
                transition DetPending -> DetDone on label det_ack;
                transition DetDone -> DetIdle on label det_reset;
            }
        }

        // Non-deterministic version: nd_ack from NdPending has TWO targets.
        // nd_ack is UNCONTROLLABLE — the environment triggers it AND
        // the outcome (Done vs Retry) is nondeterministic.
        automaton NondeterministicProtocol {
            controllable {
                label nd_req;
                label nd_reset;
                label nd_retry;
            }

            states {
                state NdIdle initial;
                state NdPending;
                state NdDone;
                state NdRetry;
            }

            transitions {
                transition NdIdle -> NdPending on label nd_req;
                // Non-deterministic: nd_ack leads to Done OR Retry
                transition NdPending -> NdDone on label nd_ack;
                transition NdPending -> NdRetry on label nd_ack;
                // Retry loops back
                transition NdRetry -> NdPending on label nd_retry;
                transition NdDone -> NdIdle on label nd_reset;
            }
        }
    }

    mu_formulas {
        // === Deterministic protocol ===

        formula det_safety {
            over DeterministicProtocol;
            body = nu X. ([] X);
        }

        // Deterministic: DetDone is reachable from ALL states (3/3)
        formula det_done_reachable {
            over DeterministicProtocol;
            body = mu X. (DetDone || <> X);
        }

        // === Non-deterministic protocol ===

        formula nd_safety {
            over NondeterministicProtocol;
            body = nu X. ([] X);
        }

        // NdDone reachability: only NdDone itself satisfies (1/4).
        // From NdPending, nd_ack is nondeterministic AND uncontrollable:
        // the environment triggers it and the outcome might be NdRetry,
        // so the system cannot GUARANTEE reaching NdDone.
        formula nd_done_reachable {
            over NondeterministicProtocol;
            body = mu X. (NdDone || <> X);
        }

        // Contrast: NdRetry is also only reachable from itself (1/4).
        // Same reason — the nondeterministic nd_ack might go to NdDone.
        formula nd_retry_reachable {
            over NondeterministicProtocol;
            body = mu X. (NdRetry || <> X);
        }

        // BUT: "NdDone OR NdRetry" IS reachable from NdPending (3/4).
        // The nondeterminism doesn't matter when BOTH outcomes satisfy.
        formula nd_either_reachable {
            over NondeterministicProtocol;
            body = mu X. (NdDone || NdRetry || <> X);
        }

        // Game-theoretic: can the controller force NdDone?
        // No (1/4) — nd_ack is uncontrollable and nondeterministic.
        formula nd_ctrl_force_done {
            over NondeterministicProtocol;
            body = mu X. (NdDone || [ (ctrl = controllable) ] X);
        }

        // Environment counterstrategy: env can prevent NdDone (3/4).
        formula nd_env_prevents_done {
            over NondeterministicProtocol;
            body = nu X. ((!NdDone) && < (ctrl = environment) > X);
        }
    }
}
