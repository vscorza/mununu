// Tutorial 02b — Multi-Label Transitions
//
// System: AXI-like bus transaction controller
//
// In hardware buses, multiple signals fire simultaneously in one clock
// cycle. Multi-label transitions model this: address, data, and control
// signals all assert together to initiate a write or read phase.
//
// Introduces: multi-label transition syntax (on label X, label Y).

context bus_transaction {
    alphabet {
        label addr_valid;
        label data_valid;
        label ctrl_write;
        label ctrl_read;
        label ack;
        label idle;
    }

    automata {
        automaton BusController {
            // Master controls address, data, and control signals.
            // ack is uncontrollable (slave-driven acknowledgment).
            controllable {
                label addr_valid;
                label data_valid;
                label ctrl_write;
                label ctrl_read;
                label idle;
            }

            states {
                state Idle initial;
                state WritePhase;
                state ReadPhase;
                state Acknowledged;
            }

            transitions {
                // Write transaction: address + data + write control fire together
                transition Idle -> WritePhase on label addr_valid, label data_valid, label ctrl_write;
                // Read transaction: address + read control fire together
                transition Idle -> ReadPhase on label addr_valid, label ctrl_read;
                // No transaction
                transition Idle -> Idle on label idle;

                // Slave acknowledges
                transition WritePhase -> Acknowledged on label ack;
                transition ReadPhase -> Acknowledged on label ack;

                // Return to idle after acknowledgment
                transition Acknowledged -> Idle on label idle;
            }
        }
    }

    mu_formulas {
        // Safety: the bus controller always stays in a valid state
        formula safety_invariant {
            over BusController;
            body = nu X. ([] X);
        }

        // Reachability: Acknowledged state is reachable
        formula ack_reachable {
            over BusController;
            body = mu X. (Acknowledged || <> X);
        }

        // From Acknowledged, can always return to Idle
        formula ack_returns_to_idle {
            over BusController;
            body = (! Acknowledged) || (mu Y. (Idle || <> Y));
        }

        // WritePhase is reachable (write transactions possible)
        formula write_reachable {
            over BusController;
            body = mu X. (WritePhase || <> X);
        }

        // ReadPhase is reachable (read transactions possible)
        formula read_reachable {
            over BusController;
            body = mu X. (ReadPhase || <> X);
        }

        // Game-theoretic: master can force reaching Acknowledged
        // despite slave controlling ack timing.
        // Uses [ (ctrl = controllable) ] for attractor semantics.
        formula master_can_reach_ack {
            over BusController;
            body = mu X. (Acknowledged || [ (ctrl = controllable) ] X);
        }
    }

    controllers {
        controller bus_safety {
            source BusController;
            satisfying safety_invariant;
        }
    }
}
