// Tutorial 09 — Unrealizable Specification Diagnosis
//
// System: Valve controller with an impossible specification
//
// The valve has two states: Open and Closed. The specification demands
// a controller that keeps the valve simultaneously open AND closed —
// a physical impossibility.
//
// Mununu's synthesis reports this as "unrealizable" and can provide
// diagnostic information: counterexamples showing why no controller
// can satisfy the spec, and deadlock traces.
//
// A second, realizable formula is included for contrast.
//
// Introduces: diagnostics { counterexample; deadlock_traces; }, unrealizability.

context unrealizable_valve {
    alphabet {
        label open_valve;
        label close_valve;
        label pressure_rise;
        label pressure_drop;
    }

    automata {
        automaton Valve {
            controllable {
                label open_valve;
                label close_valve;
            }

            states {
                state Closed initial;
                state Open;
            }

            transitions {
                transition Closed -> Open on label open_valve;
                transition Open -> Closed on label close_valve;
                // Environment events
                transition Closed -> Closed on label pressure_drop;
                transition Open -> Open on label pressure_rise;
            }
        }
    }

    mu_formulas {
        // UNREALIZABLE: demands being in both Open and Closed simultaneously.
        // No state satisfies (Open && Closed) since they are distinct states.
        formula impossible_spec {
            over Valve;
            body = Open && Closed;
        }

        // REALIZABLE: the valve can reach Open state from any state.
        formula open_reachable {
            over Valve;
            body = mu X. (Open || <> X);
        }

        // Safety invariant (always realizable for well-formed automata)
        formula safety_invariant {
            over Valve;
            body = nu X. ([] X);
        }
    }

    controllers {
        // This controller will be UNREALIZABLE.
        // Diagnostics reveal why: no initial state satisfies the spec.
        controller impossible_valve {
            source Valve;
            satisfying impossible_spec;
            diagnostics {
                counterexample = true;
                deadlock_traces = true;
            }
        }

        // This controller IS realizable (contrast with above).
        controller safe_valve {
            source Valve;
            satisfying safety_invariant;
        }
    }
}
