// Tutorial 01 — Basic Modeling: Context, Alphabet, States, Transitions
//
// System: Industrial door lock controller
//
// This example introduces the core CTXDSL structure step by step:
//   1. context — the top-level container
//   2. alphabet — declares all possible signals/events
//   3. automaton — a finite-state machine
//   4. states — with one marked as `initial`
//   5. transitions — edges labeled with signals
//
// The DoorLock tracks failed unlock attempts using explicit states.
// After 3 bad codes, the lock enters a Lockout state requiring an
// admin reset. This models a real industrial access control system.

context door_lock {
    alphabet {
        label unlock;
        label lock;
        label bad_code;
        label timeout;
        label reset;
    }

    automata {
        automaton DoorLock {
            states {
                state Locked initial;
                state Unlocked;
                state Strike1;
                state Strike2;
                state Lockout;
            }

            transitions {
                // Correct code unlocks from any locked/strike state
                transition Locked -> Unlocked on label unlock;
                transition Strike1 -> Unlocked on label unlock;
                transition Strike2 -> Unlocked on label unlock;

                // Door relocks
                transition Unlocked -> Locked on label lock;
                transition Unlocked -> Locked on label timeout;

                // Bad code advances through strikes toward lockout
                transition Locked -> Strike1 on label bad_code;
                transition Strike1 -> Strike2 on label bad_code;
                transition Strike2 -> Lockout on label bad_code;

                // Admin reset from lockout
                transition Lockout -> Locked on label reset;
            }
        }
    }

    mu_formulas {
        // Safety: DoorLock always stays in a valid state
        formula safety_invariant {
            over DoorLock;
            body = nu X. ([] X);
        }

        // Reachability: the Lockout state is reachable (non-trivial)
        formula lockout_reachable {
            over DoorLock;
            body = mu X. (Lockout || <> X);
        }

        // Recovery: from Lockout, Locked is always reachable via reset
        formula can_recover {
            over DoorLock;
            body = (! Lockout) || (mu Y. (Locked || <> Y));
        }

        // Cycle: from any state, Unlocked is reachable
        formula unlock_reachable {
            over DoorLock;
            body = mu X. (Unlocked || <> X);
        }
    }
}
