(set-logic QF_BV)
(set-option :produce-interpolants true)
(declare-fun a0 () (_ BitVec 16))
(declare-fun b0 () (_ BitVec 16))
(declare-fun a1 () (_ BitVec 16))
(declare-fun b1 () (_ BitVec 16))
; A: the TRUE inductive region (a<=144 AND b<=a) AND one step. This is what an IC3 frame would converge to.
(assert (and (bvule a0 (_ bv144 16)) (bvule b0 a0)
             (= a1 (ite (bvult a0 (_ bv100 16)) (bvadd a0 b0) a0))
             (= b1 a0)))
(get-interpolant I (bvule a1 (_ bv144 16)))
