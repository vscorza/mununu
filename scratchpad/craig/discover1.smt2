(set-logic QF_BV)
(set-option :produce-interpolants true)
(declare-fun data0 () (_ BitVec 48))
(declare-fun target0 () (_ BitVec 48))
(declare-fun data1 () (_ BitVec 48))
(declare-fun target1 () (_ BitVec 48))
