(set-logic QF_BV)
(set-option :produce-interpolants true)
(declare-fun d0 () (_ BitVec 48))
(declare-fun t0 () (_ BitVec 48))
(declare-fun d1 () (_ BitVec 48))
(declare-fun t1 () (_ BitVec 48))
(declare-fun d2 () (_ BitVec 48))
(declare-fun t2 () (_ BitVec 48))
(assert (and (= d1 (bvadd d0 (_ bv1 48))) (= t1 (bvadd t0 (_ bv1 48)))
             (= d2 (bvadd d1 (_ bv1 48))) (= t2 (bvadd t1 (_ bv1 48)))
             (= d0 t0)))
(get-interpolant I (= d2 t2))
